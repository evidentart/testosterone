venv/

# Local secrets (copy from .env.example)
.env

# Default local SQLite DB when DATABASE_URL is unset (testo_core/repository/db_config.py)
uqo_history.db
testo_history.db

# Generated sandbox DB from the test suite (tests/artifacts/)
tests/artifacts/*.db

# Cursor IDE local state (debug logs, plans, rules, etc.)
.cursor/

# Local e2e test scratch (cleanup ledgers, etc.)
.artifacts/

# Built Python distribution artifacts
dist/
build/
*.egg-info/

# Local release-gate run logs
artifacts/release-gate-*/

# Generated report HTML (static/history/ is served by the API for each run's Report Links)
static/

# Run data of an installed package run from this directory (testo_core/paths.py)
.testo/

# Persisted run history (SQLite + per-run HTML snapshots)
artifacts/uqo_run_history.sqlite
artifacts/testo_sandbox.db
artifacts/history/

# AI settings saved by the API (never contains the key)
artifacts/ai_settings.json

