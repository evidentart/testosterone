.coverage
coverage.xml
artifacts/allure-report/
artifacts/allure-results/
artifacts/allure-results-archive/
artifacts/allure-report.zip
artifacts/metrics.json

# Runtime logs
logs/

# Frontend workspace artifacts
frontend/node_modules/
frontend/dist/

# Root Node tooling (Allure CLI, commitlint)
node_modules/

